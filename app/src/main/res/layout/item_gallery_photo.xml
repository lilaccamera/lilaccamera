<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/gallery_photo_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/gallery_photo_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF1A1A1A"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/gallery_photo_selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/gallery_photo_selection_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <!-- At most two tags; the tile picks them, most telling first. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gallery_photo_tag_1"
                style="@style/GalleryTileTag"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gallery_photo_tag_2"
                style="@style/GalleryTileTag"
                android:layout_marginStart="3dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</merge>
